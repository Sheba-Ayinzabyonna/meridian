# Meridian Environment Variables

# n8n Webhook URL for plan generation
VITE_MERIDIAN_PLAN_WEBHOOK_URL=https://your-n8n-instance.com/webhook/meridian-plan-generator

# Development flag: Use mock data for testing (optional)
# Set to 'true' to test the entire flow without n8n webhook
# VITE_USE_MOCK_DATA=true

# Development/Production flags (set by Vite automatically)
# VITE_ENV defaults to 'development' when running `npm run dev`
# and 'production' when running `npm run build`
